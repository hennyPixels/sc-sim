5. ADD SORTING:
   private string sortColumn = "Name";
   private bool sortAscending = true;

   private IEnumerable<Part> SortedParts => sortAscending
       ? parts?.OrderBy(p => GetSortValue(p))
       : parts?.OrderByDescending(p => GetSortValue(p));

   private object GetSortValue(Part p) => sortColumn switch
   {
       "Name" => p.Name,
       "Quantity" => p.Quantity,
       "PartNumber" => p.PartNumber,
       _ => p.Name
   };
